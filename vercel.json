{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    },
    "backend": {
      "root": ".",
      "entrypoint": "backend.service:app",
      "framework": "fastapi"
    }
  },
  "rewrites": [
    {
      "source": "/api(/.*)?",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/share/:path*",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/trending-research",
      "destination": "/index.html"
    },
    {
      "source": "/ai-supply-chain",
      "destination": "/index.html"
    },
    {
      "source": "/sec-filings",
      "destination": "/index.html"
    },
    {
      "source": "/home",
      "destination": "/index.html"
    },
    {
      "source": "/marketpulse",
      "destination": "/index.html"
    },
    {
      "source": "/daily-briefing",
      "destination": "/index.html"
    },
    {
      "source": "/watchlist",
      "destination": "/index.html"
    },
    {
      "source": "/tracked-voices",
      "destination": "/index.html"
    },
    {
      "source": "/data-sources",
      "destination": "/index.html"
    },
    {
      "source": "/trading-room",
      "destination": "/index.html"
    },
    {
      "source": "/account",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/plans",
      "destination": "/index.html"
    },
    {
      "source": "/how-it-works",
      "destination": "/index.html"
    },
    {
      "source": "/contact",
      "destination": "/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/index.html"
    },
    {
      "source": "/terms",
      "destination": "/index.html"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/forgot-password",
      "destination": "/index.html"
    },
    {
      "source": "/owner-setup",
      "destination": "/index.html"
    },
    {
      "source": "/admin/import",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "frontend"
      }
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "regions": [
    "fra1"
  ],
  "crons": [
    {
      "path": "/api/cron/collect",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/email",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/social",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/sec",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/research",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/drive",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/echo",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/uw-pilot",
      "schedule": "*/10 * * * *"
    }
  ]
}
